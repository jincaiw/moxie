{
  "name": "moxie-editor",
  "version": "0.16.161",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "desktopName": "moxie-editor",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "desktop": "npm run build && electron .",
    "desktop:dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && cross-env MOXIE_DEV=1 electron .\"",
    "test": "playwright test",
    "benchmark:long-doc": "MOXIE_PERF=1 playwright test tests/performance.spec.ts --workers=1",
    "package:mac": "npm run build && electron-builder --mac --publish never",
    "package:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "package:linux": "npm run build && electron-builder --linux AppImage --x64 --publish never",
    "test:desktop": "node tests-desktop/files.cjs",
    "package:mac:zip": "npm run build && electron-builder --mac zip --publish never",
    "format": "prettier --write src electron tests tests-desktop docs README.md *.json *.ts .github/workflows/*.yml"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.8.1",
    "@codemirror/lang-markdown": "^6.3.3",
    "@codemirror/language": "^6.11.0",
    "@codemirror/language-data": "^6.5.1",
    "@codemirror/search": "^6.5.10",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.36.5",
    "@lezer/common": "^1.2.3",
    "@lezer/highlight": "^1.2.5",
    "@lezer/markdown": "^1.7.2",
    "dompurify": "^3.2.6",
    "electron-updater": "^6.8.9",
    "html-entities": "^2.6.0",
    "html-to-docx": "^1.8.0",
    "js-yaml": "^4.3.2",
    "katex": "^0.16.22",
    "lucide-react": "^0.468.0",
    "marked": "^15.0.12",
    "mermaid": "^11.17.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.1",
    "@types/js-yaml": "^4.0.9",
    "@types/katex": "^0.16.7",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^35.1.5",
    "electron-builder": "^26.0.12",
    "prettier": "^3.9.9",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "wait-on": "^8.0.3"
  },
  "build": {
    "appId": "studio.moxie.editor",
    "productName": "墨写",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "icon": "build/icon.icns",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ]
    },
    "win": {
      "icon": "build/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false
    },
    "linux": {
      "icon": "build/icon.png",
      "syncDesktopName": true,
      "synopsis": "本地 Markdown 写作编辑器",
      "category": "Office",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "directories": {
      "output": "release"
    },
    "artifactName": "Moxie-${version}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "owner": "jincaiw",
        "repo": "moxie",
        "releaseType": "release"
      }
    ],
    "compression": "normal"
  },
  "description": "本地 Markdown 桌面编辑器",
  "author": "Moxie"
}
